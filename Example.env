# ======================= TELEGRAM =======================
API_ID=<apna API_ID (my.telegram.org)>
API_HASH=<apna API_HASH>

# ---- RUN MODE: sirf EK fill karo, dusra KHALI chhod do (dono bhare toh bot start nahi hoga)
# 1) BOT_TOKEN      -> normal Telegram bot chalega (@BotFather se token). Dashboard nahi hota.
# 2) STRING_SESSION -> tumhara apna account chalega + /admin dashboard (python gen_session.py se banao)
BOT_TOKEN=
STRING_SESSION=

# ---- OWNERS: jo log owner commands chala sakte hain (.chatoff .chaton .stickers .tag .stop)
# comma se alag Telegram user ids (@userinfobot se milti hai): OWNER_IDS=111111111,222222222
# STRING_SESSION mode: account khud hamesha owner hai, yahan extra log add hote hain
# BOT_TOKEN mode: sirf yahan likhe ids owner hain (khali = owner commands band)
OWNER_IDS=

# ======================= DATABASE / AI =======================
MONGO_URI=<mongodb+srv://user:password@cluster.../?retryWrites=true&w=majority>
DEEPSEEK_API_KEY=<Groq key>
DEEPSEEK_URL=https://api.groq.com/openai/v1/chat/completions
DEEPSEEK_MODEL=openai/gpt-oss-120b
FALLBACK_URL=https://api.groq.com/openai/v1/chat/completions
FALLBACK_API_KEY=<wahi Groq key>
FALLBACK_MODEL=openai/gpt-oss-20b
FALLBACK2_URL=https://api.thegrid.ai/v1/chat/completions
FALLBACK2_API_KEY=<Grid key>
FALLBACK2_MODEL=text-prime

# ======================= PERSONA / LISA DATASET =======================
PERSONA_NAME=Lisa
LISA_DATASET=1           # data/lisa_examples.jsonl.gz se har reply ke liye tone examples
LISA_EXAMPLES=3          # ek reply me kitne examples (0-8)
REPLY_DELAY=3
MAX_TOKENS=600
TEMPERATURE=1.1
DB_NAME=girl_chatbot
HISTORY_LIMIT=10
MEMORY_DAYS=90
LONG_MEMORY=1
MEMORY_EXTRACT_EVERY=10m
STICKER_REPLY_CHANCE=0.7   # sirf STRING_SESSION mode me
STICKER_ANY=0
STYLE_LEARNING=1

# ======================= .tag (group me sab ko tag) =======================
TAG_BATCH=5        # ek message me kitne log tag hon (1-10)
TAG_DELAY=3        # do messages ke beech seconds (FloodWait se bachne ke liye kam mat karo)
TAG_MAX=1000       # ek baar me max kitne members tag hon

# ======================= DASHBOARD (sirf STRING_SESSION mode) =======================
# lamba, unique password (kam se kam 8 characters). Isse dashboard tumhare poore account ka control deta hai.
ADMIN_PASSWORD=<lamba password>
LOG_DAYS=30
# DASH_MAX_DIALOGS=500        # dashboard me kitne chats load hon
# DASH_MEDIA_MAX_MB=20        # photo/file upload-download limit
# DASH_ALLOW_DANGEROUS=1      # 0 = delete chat / leave / clear / sessions end button band
